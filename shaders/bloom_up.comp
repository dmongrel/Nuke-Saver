#version 450

// Bloom, the upsample half of the chain (spec 8.1): a 3x3 tent filter, added into the level below.
//
// Additive rather than a blend, and a tent rather than a bilinear fetch, because both halves of
// that are what make the chain read as one smooth falloff instead of as five rings. The
// destination is read as well as written, so it is a read-write storage image here rather than the
// write-only one the downsample uses.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uSource;
layout(set = 0, binding = 1, rgba16f) uniform image2D uDestination;

layout(push_constant) uniform Push {
    vec2  destinationSize;
    float threshold;
    float knee;
    float firstLevel;
    float intensity;  // how much of the smaller level is added into this one
    float pad0;
    float pad1;
} pc;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= int(pc.destinationSize.x) || texel.y >= int(pc.destinationSize.y)) return;

    vec2 uv = (vec2(texel) + 0.5) / pc.destinationSize;

    // The tent's radius is in the *source's* texels, which are twice the size of the
    // destination's. That is what makes the filter widen as it climbs back down the chain.
    vec2 r = 1.0 / vec2(textureSize(uSource, 0));

    vec3 sum = texture(uSource, uv + r * vec2(-1.0, -1.0)).rgb * 1.0;
    sum += texture(uSource, uv + r * vec2(0.0, -1.0)).rgb * 2.0;
    sum += texture(uSource, uv + r * vec2(1.0, -1.0)).rgb * 1.0;
    sum += texture(uSource, uv + r * vec2(-1.0, 0.0)).rgb * 2.0;
    sum += texture(uSource, uv).rgb * 4.0;
    sum += texture(uSource, uv + r * vec2(1.0, 0.0)).rgb * 2.0;
    sum += texture(uSource, uv + r * vec2(-1.0, 1.0)).rgb * 1.0;
    sum += texture(uSource, uv + r * vec2(0.0, 1.0)).rgb * 2.0;
    sum += texture(uSource, uv + r * vec2(1.0, 1.0)).rgb * 1.0;
    sum /= 16.0;

    vec3 existing = imageLoad(uDestination, texel).rgb;
    imageStore(uDestination, texel, vec4(existing + sum * pc.intensity, 1.0));
}
