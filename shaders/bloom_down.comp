#version 450

// Bloom, the downsample half of the chain (spec 8.1).
//
// The thirteen-tap filter, not a box. With a flash at 12,000 linear and a fireball at 3,000 next
// to a night desert at 0.01, a box downsample turns a single bright pixel into a square that
// crawls as the camera moves — the classic firefly — and the first mip is where that is decided.
// So the first level takes a Karis average, weighting each group of four by its own inverse
// luminance, which is the one place it is worth the extra arithmetic.
//
// The first level also bins the auto-exposure histogram (spec 8.2), which is what
// exposure_histogram.comp does on its own when there is no bloom chain. It reads every second HDR
// texel each way, and each of those lies under this pass's centre tap, so folded in here it costs
// a fetch from cache instead of a second read of the whole HDR image from memory.

// 16 x 16, so that on the first level each invocation owns one of the 256 histogram bins for the
// clear and the merge, exactly as in exposure_histogram.comp.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uSource;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D uDestination;

#define EXPOSURE_BINDING 2
#include "exposure.glsl"

layout(push_constant) uniform Push {
    vec2  destinationSize;
    float threshold;  // below this the source contributes nothing; 0 disables it
    float knee;       // width of the soft shoulder around the threshold
    float firstLevel; // 1 on the first downsample, where the Karis average is applied
    float intensity;  // unused here, kept so both halves share one push block
    float pad0;
    float pad1;
} pc;

float Karis(vec3 c) { return 1.0 / (1.0 + dot(c, vec3(0.2126, 0.7152, 0.0722))); }

vec3 Group(vec3 a, vec3 b, vec3 c, vec3 d, bool weighted) {
    if (!weighted) return (a + b + c + d) * 0.25;

    float wa = Karis(a), wb = Karis(b), wc = Karis(c), wd = Karis(d);
    return (a * wa + b * wb + c * wc + d * wd) / max(wa + wb + wc + wd, 1e-4);
}

void Downsample(ivec2 texel) {
    if (texel.x >= int(pc.destinationSize.x) || texel.y >= int(pc.destinationSize.y)) return;

    // Sample in the source's own space, at the centre of the four texels this one covers.
    vec2 uv     = (vec2(texel) + 0.5) / pc.destinationSize;
    vec2 stride = 1.0 / vec2(textureSize(uSource, 0));

    vec3 a = texture(uSource, uv + stride * vec2(-2.0, -2.0)).rgb;
    vec3 b = texture(uSource, uv + stride * vec2( 0.0, -2.0)).rgb;
    vec3 c = texture(uSource, uv + stride * vec2( 2.0, -2.0)).rgb;
    vec3 d = texture(uSource, uv + stride * vec2(-2.0,  0.0)).rgb;
    vec3 e = texture(uSource, uv).rgb;
    vec3 f = texture(uSource, uv + stride * vec2( 2.0,  0.0)).rgb;
    vec3 g = texture(uSource, uv + stride * vec2(-2.0,  2.0)).rgb;
    vec3 h = texture(uSource, uv + stride * vec2( 0.0,  2.0)).rgb;
    vec3 i = texture(uSource, uv + stride * vec2( 2.0,  2.0)).rgb;

    vec3 j = texture(uSource, uv + stride * vec2(-1.0, -1.0)).rgb;
    vec3 k = texture(uSource, uv + stride * vec2( 1.0, -1.0)).rgb;
    vec3 l = texture(uSource, uv + stride * vec2(-1.0,  1.0)).rgb;
    vec3 m = texture(uSource, uv + stride * vec2( 1.0,  1.0)).rgb;

    bool weighted = pc.firstLevel > 0.5;

    vec3 result = Group(j, k, l, m, weighted) * 0.5;
    result += Group(a, b, d, e, weighted) * 0.125;
    result += Group(b, c, e, f, weighted) * 0.125;
    result += Group(d, e, g, h, weighted) * 0.125;
    result += Group(e, f, h, i, weighted) * 0.125;

    // The threshold, on the first level only. Bloom is meant to be what the lens does with light
    // that is genuinely bright, and applying it again at every level would eat the chain.
    if (pc.firstLevel > 0.5 && pc.threshold > 0.0) {
        float luminance = dot(result, vec3(0.2126, 0.7152, 0.0722));

        // A soft knee rather than a step, so a surface drifting past the threshold does not pop.
        float soft  = clamp(luminance - pc.threshold + pc.knee, 0.0, 2.0 * pc.knee);
        soft        = soft * soft / (4.0 * pc.knee + 1e-4);
        float scale = max(soft, luminance - pc.threshold) / max(luminance, 1e-4);

        result *= scale;
    }

    imageStore(uDestination, texel, vec4(result, 1.0));
}

shared uint sBins[kBins];

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);

    // firstLevel is a push constant, so these branches are uniform across the workgroup and the
    // barriers inside them are legal.
    bool histogram = pc.firstLevel > 0.5;
    uint local     = gl_LocalInvocationIndex;
    if (histogram) {
        sBins[local] = 0u;
        barrier();
    }

    Downsample(texel);

    if (histogram) {
        // The same texels exposure_histogram.comp takes: (2x, 2y) for every such point inside the
        // HDR image. The host dispatches enough of this level to reach all of them, which on an
        // odd-sized image is one column or row past the downsample's own extent.
        ivec2 coord = texel * 2;
        if (all(lessThan(coord, textureSize(uSource, 0)))) {
            vec3 hdr = texelFetch(uSource, coord, 0).rgb;
            atomicAdd(sBins[LogLumToBin(Luminance(hdr))], 1u);
        }

        barrier();
        if (sBins[local] != 0u) atomicAdd(ex.bins[local], sBins[local]);
    }
}
