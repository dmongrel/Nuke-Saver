#version 450

// M0 toolchain probe. Exists to prove glslc runs from the Makefile, that the SPIR-V is
// embedded in the executable, and that the blob survives the link. It is never dispatched.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Probe {
    uint values[];
} probe;

void main() {
    uint i = gl_GlobalInvocationID.x;
    probe.values[i] = i * 2u;
}
